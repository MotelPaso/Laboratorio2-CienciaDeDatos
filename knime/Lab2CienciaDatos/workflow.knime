    <config key="workflow_credentials"/>
    <config key="annotations">
        <config key="annotation_0">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E1 · Carga&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Lee data/tabla_modelado.csv (ruta relativa al workflow), generada por Etapa0.py a partir de transactions_train.csv y articles.csv. 1 fila = 1 artículo (88.584 con ≥5 ventas en observación).&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="14084856"/>
            <entry key="x-coordinate" type="xint" value="-220"/>
            <entry key="y-coordinate" type="xint" value="215"/>
            <entry key="width" type="xint" value="380"/>
            <entry key="height" type="xint" value="240"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="14084856"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_1">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E2 · Comprensión (EDA)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Rama lateral: estadísticos y faltantes, correlación entre numéricas, tasa positiva global (esperado 26,9 %), tasa de demanda por grupo de producto y box plots por clase. No altera el flujo principal.&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16640976"/>
            <entry key="x-coordinate" type="xint" value="185"/>
            <entry key="y-coordinate" type="xint" value="-445"/>
            <entry key="width" type="xint" value="480"/>
            <entry key="height" type="xint" value="590"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="16640976"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_2">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E3 · Preparación&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Duplicados por article_id (0 esperados). Se excluyen article_id y unidades_prox_30d (fuga). Categorías con frecuencia &amp;lt;1 % → OTROS con 7 Rule Engine (solo X, sin usar y). One-hot sobre 8 categóricas. Conteos con cola larga → ln(1+x) antes del Z-score.&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="14022115"/>
            <entry key="x-coordinate" type="xint" value="185"/>
            <entry key="y-coordinate" type="xint" value="225"/>
            <entry key="width" type="xint" value="1720"/>
            <entry key="height" type="xint" value="225"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="14022115"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_3">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E4 · Transformación&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Partición 70/30 estratificada por y_demanda_30d, seed 42. Imputación (mediana/moda) y Z-score se ajustan SOLO en train y se aplican a test vía PMML. Filtro de baja varianza (0,001) y revisión de correlación |r|&amp;gt;0,8 sobre train. Pares con |r|&amp;gt;0,8 (E4.7): se quitan clientes_unicos, dias_con_venta, unidades_ult_90d, precio_max, precio_min y precio_ultimo en train y test (E4.8).&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16577487"/>
            <entry key="x-coordinate" type="xint" value="1895"/>
            <entry key="y-coordinate" type="xint" value="-40"/>
            <entry key="width" type="xint" value="660"/>
            <entry key="height" type="xint" value="560"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="16577487"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_4">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E5 · Modelado&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Regresión logística (SAG, 1000 épocas, referencia &amp;quot;0&amp;quot;). M1: prior Gauss (L2, var 1). M2: prior Laplace (L1). M3: L2 sin dummies de department_name y product_type_name.&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="15260399"/>
            <entry key="x-coordinate" type="xint" value="2560"/>
            <entry key="y-coordinate" type="xint" value="-85"/>
            <entry key="width" type="xint" value="400"/>
            <entry key="height" type="xint" value="865"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="15260399"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_5">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E6 · Evaluación&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Umbral 0,5. Matriz de confusión, accuracy, precision, recall, especificidad, F1, ROC-AUC (Mann-Whitney), Brier, log-loss, calibración (10 bins) y lift por decil, calculados sobre test.&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16440280"/>
            <entry key="x-coordinate" type="xint" value="2950"/>
            <entry key="y-coordinate" type="xint" value="-130"/>
            <entry key="width" type="xint" value="1600"/>
            <entry key="height" type="xint" value="790"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="16440280"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_6">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;E6 · Coeficientes&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Coeficientes de M1-M3 con odds ratio = exp(β) e IC 95 % = exp(β ± 1,96·SE).&lt;/p&gt;"/>
