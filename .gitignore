knime/Lab2CienciaDatos/data/
knime/Lab2CienciaDatos/resultados/

# Cachés internas de nodos y estado de sesión
knime/Lab2CienciaDatos/*/port_*
knime/Lab2CienciaDatos/*/internal/
knime/Lab2CienciaDatos/.knimeLock
knime/Lab2CienciaDatos/.savedWithData

# Documentos de la asignatura
*.md

# Cachés de vistas y artefactos de KNIME
knime/Lab2CienciaDatos/*/internalTables/
knime/Lab2CienciaDatos/.artifacts/

# Excepción: README del repositorio
!README.md

